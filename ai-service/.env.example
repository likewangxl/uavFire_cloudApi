AI_SERVICE_HOST=0.0.0.0
AI_SERVICE_PORT=8000
AI_SERVICE_LOG_LEVEL=info
MODEL_DEVICE=cpu
MODEL_VARIANT=yolov8n

# --- 可见光 YOLO(fire/smoke 双类,yolov8s@960,hardneg v2 20260702) ---
# 设置 MODEL_PATH 即启用 YoloVisibleDetector,留空回退 color 启发式
AI_SERVICE_VISIBLE_YOLO_MODEL_PATH=weights/visible-fire-smoke-yolov8s-960-hardneg-20260702.pt
AI_SERVICE_VISIBLE_YOLO_IMGSZ=960
AI_SERVICE_VISIBLE_CONFIDENCE_FLOOR=0.25
AI_SERVICE_VISIBLE_TARGET_CLASSES=fire,smoke

# M300 payload profiles are fail-closed. Add a model only after its visible-light
# validation set passes acceptance, then optionally assign a separate model/threshold.
AI_SERVICE_VERIFIED_PAYLOAD_MODELS=
AI_SERVICE_H20_VISIBLE_YOLO_MODEL_PATH=
AI_SERVICE_H20_VISIBLE_CONFIDENCE_FLOOR=0.25
AI_SERVICE_H20T_VISIBLE_YOLO_MODEL_PATH=
AI_SERVICE_H20T_VISIBLE_CONFIDENCE_FLOOR=0.25
AI_SERVICE_H30_VISIBLE_YOLO_MODEL_PATH=
AI_SERVICE_H30_VISIBLE_CONFIDENCE_FLOOR=0.25
AI_SERVICE_H30T_VISIBLE_YOLO_MODEL_PATH=
AI_SERVICE_H30T_VISIBLE_CONFIDENCE_FLOOR=0.25

# --- 热成像 YOLO(单类 fire,yolov8n@640,真值训练 gt-scratch 20260709,val mAP50=0.854) ---
# thermal YOLO 仅在 use_continuous_runner=true 时生效;mode 可选 brightness/yolo/max
# 输入要求:M4T 端设白热(white-hot)调色板,与训练域(灰度)对齐
AI_SERVICE_USE_CONTINUOUS_RUNNER=true
AI_SERVICE_THERMAL_DETECTOR_MODE=yolo
AI_SERVICE_THERMAL_YOLO_MODEL_PATH=weights/thermal-fire-yolov8n-640-gt-20260709.pt
AI_SERVICE_THERMAL_YOLO_IMGSZ=640
AI_SERVICE_THERMAL_YOLO_CONF_THRESHOLD=0.25
