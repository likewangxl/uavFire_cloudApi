<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/home_dashboard_background"
    android:paddingStart="28dp"
    android:paddingTop="12dp"
    android:paddingEnd="28dp"
    android:paddingBottom="10dp">

    <LinearLayout
        android:id="@+id/leftRoot"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginEnd="16dp"
        android:orientation="vertical"
        app:layout_constraintBottom_toTopOf="@+id/footerText"
        app:layout_constraintEnd_toStartOf="@+id/rightPanel"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="86dp"
            android:background="@drawable/home_card_panel"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="18dp"
            android:paddingEnd="18dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center_vertical"
                android:text="🔥  飞行限制\n限高 1500 m\nUTMISS | RID"
                android:textColor="#FFEAF6FF"
                android:textSize="13dp" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center_vertical"
                android:text="📍  作业空间\nTest Group One\nCloud Sample Area"
                android:textColor="#FFEAF6FF"
                android:textSize="13dp" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center_vertical"
                android:text="▰  任务空间\n23.6 GB 可用\n共 64 GB"
                android:textColor="#FFEAF6FF"
                android:textSize="13dp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="118dp"
            android:layout_marginTop="10dp"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginEnd="9dp"
                android:layout_weight="1"
                android:adjustViewBounds="false"
                android:scaleType="fitXY"
                android:src="@drawable/home_feature_fire" />

            <ImageView
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginEnd="9dp"
                android:layout_weight="1"
                android:adjustViewBounds="false"
                android:scaleType="fitXY"
                android:src="@drawable/home_feature_route" />

            <ImageView
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginEnd="9dp"
                android:layout_weight="1"
                android:adjustViewBounds="false"
                android:scaleType="fitXY"
                android:src="@drawable/home_feature_dual_stream" />

            <ImageButton
                android:id="@+id/probeWaypointButton"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginEnd="9dp"
                android:layout_weight="1"
                android:adjustViewBounds="false"
                android:background="@android:color/transparent"
                android:contentDescription="@null"
                android:padding="0dp"
                android:scaleType="fitXY"
                android:src="@drawable/home_feature_kmz" />

            <ImageView
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:adjustViewBounds="false"
                android:scaleType="fitXY"
                android:src="@drawable/home_feature_device" />
        </LinearLayout>

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="10dp"
            android:layout_weight="1"
            android:background="@drawable/home_card_panel">

            <ImageView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="centerCrop"
                android:src="@drawable/home_fire_hero" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="bottom"
                android:orientation="vertical"
                android:paddingStart="24dp"
                android:paddingTop="18dp"
                android:paddingEnd="24dp"
                android:paddingBottom="20dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="智能集群大载重无人机灭火系统"
                    android:textColor="#FFFFFFFF"
                    android:textSize="24dp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="7dp"
                    android:text="面向火情识别联动、任务调度、航线规划与投放执行的智慧消防平台"
                    android:textColor="#E6FFFFFF"
                    android:textSize="13dp" />
            </LinearLayout>
        </FrameLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="86dp"
            android:layout_marginTop="10dp"
            android:orientation="horizontal">

            <ImageButton
                android:id="@+id/refreshButton"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginEnd="12dp"
                android:layout_weight="1"
                android:adjustViewBounds="false"
                android:background="@android:color/transparent"
                android:contentDescription="@null"
                android:padding="0dp"
                android:scaleType="fitXY"
                android:src="@drawable/home_action_refresh" />

            <ImageButton
                android:id="@+id/startButton"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:adjustViewBounds="false"
                android:background="@android:color/transparent"
                android:contentDescription="@null"
                android:padding="0dp"
                android:scaleType="fitXY"
                android:src="@drawable/home_action_dual_stream" />
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/rightPanel"
        android:layout_width="400dp"
        android:layout_height="0dp"
        android:background="@drawable/home_card_panel"
        android:orientation="vertical"
        android:padding="15dp"
        app:layout_constraintBottom_toTopOf="@+id/footerText"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="36dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="当前飞行器▽"
                android:textColor="#FFFFFFFF"
                android:textSize="18dp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="● 已连接"
                android:textColor="#FF4CE978"
                android:textSize="12dp" />
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="92dp"
            android:gravity="center"
            android:text="✈\nMATRICE 4T ⇆"
            android:textColor="#FFFFFFFF"
            android:textSize="24dp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="94dp"
            android:background="@drawable/home_card_panel"
            android:gravity="center_vertical"
            android:lineSpacingExtra="6dp"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:text="连接状态                         CAPABILITY_READY\n可见光                                      true\n红外                                         true"
            android:textColor="#FF5CEB84"
            android:textSize="12dp" />

        <TextView
            android:id="@+id/statusText"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="9dp"
            android:layout_weight="1"
            android:background="@drawable/home_card_panel"
            android:gravity="top"
            android:padding="12dp"
            android:text="@string/app_status_placeholder"
            android:textColor="#CCFFFFFF"
            android:textSize="11dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="68dp"
            android:layout_marginTop="9dp"
            android:background="@drawable/home_card_panel"
            android:gravity="center_vertical"
            android:paddingStart="18dp"
            android:paddingEnd="18dp"
            android:text="挂载设备\n🤖 CAM  负载 1       ▣ PSDK  已连接"
            android:textColor="#DDEAF6FF"
            android:textSize="13dp" />

        <ImageButton
            android:id="@+id/openSampleToolsButton"
            android:layout_width="match_parent"
            android:layout_height="90dp"
            android:layout_marginTop="10dp"
            android:adjustViewBounds="false"
            android:background="@android:color/transparent"
            android:contentDescription="@null"
            android:padding="0dp"
            android:scaleType="fitXY"
            android:src="@drawable/home_open_flight" />
    </LinearLayout>

    <TextView
        android:id="@+id/footerText"
        android:layout_width="0dp"
        android:layout_height="20dp"
        android:gravity="center_vertical"
        android:text="ⓘ UAV Fire RC Plus MSDK Agent  |  Android execution shell for the dual-stream PoC."
        android:textColor="#66FFFFFF"
        android:textSize="10dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />
</androidx.constraintlayout.widget.ConstraintLayout>
