<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/home_dashboard_background"
    android:paddingStart="20dp"
    android:paddingTop="14dp"
    android:paddingEnd="20dp"
    android:paddingBottom="10dp">

    <ImageView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop"
        android:src="@drawable/home_fire_hero" />

    <View
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#66020812" />

    <LinearLayout
        android:id="@+id/topStatusBar"
        android:layout_width="0dp"
        android:layout_height="70dp"
        android:baselineAligned="false"
        android:orientation="horizontal"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <TextView
            android:id="@+id/flightLimitText"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginEnd="8dp"
            android:layout_weight="0.85"
            android:background="@drawable/home_card_panel"
            android:gravity="center_vertical"
            android:lineSpacingExtra="3dp"
            android:maxLines="2"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:text="飞行限制\n未连接"
            android:textColor="#FFEAF6FF"
            android:textSize="13dp" />

        <TextView
            android:id="@+id/taskSpaceText"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginEnd="8dp"
            android:layout_weight="1.15"
            android:background="@drawable/home_card_panel"
            android:ellipsize="end"
            android:gravity="center_vertical"
            android:lineSpacingExtra="3dp"
            android:maxLines="2"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:text="任务空间\n读取中"
            android:textColor="#FFEAF6FF"
            android:textSize="13dp" />

        <TextView
            android:id="@+id/aircraftStatusText"
            android:layout_width="270dp"
            android:layout_height="match_parent"
            android:background="@drawable/home_card_panel"
            android:gravity="center"
            android:maxLines="2"
            android:text="当前飞行器\nUNKNOWN    未连接"
            android:textColor="#FFEAF6FF"
            android:textSize="13dp" />
    </LinearLayout>

    <FrameLayout
        android:id="@+id/titleArea"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="12dp"
        android:layout_marginBottom="10dp"
        android:background="@drawable/home_card_panel"
        app:layout_constraintBottom_toTopOf="@+id/bottomActionBar"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/topStatusBar">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="top"
            android:orientation="vertical"
            android:paddingStart="0dp"
            android:paddingTop="28dp"
            android:paddingEnd="84dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="智能集群大载重无人机灭火系统"
                android:textColor="#FFFFFFFF"
                android:textSize="24dp"
                android:textStyle="bold"
                android:singleLine="true" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/aiDetectionPanel"
            android:layout_width="260dp"
            android:layout_height="76dp"
            android:layout_gravity="top|end"
            android:layout_marginTop="18dp"
            android:layout_marginEnd="18dp"
            android:background="@drawable/home_card_panel"
            android:orientation="vertical"
            android:paddingStart="16dp"
            android:paddingTop="10dp"
            android:paddingEnd="12dp"
            android:paddingBottom="8dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="30dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/ai_detection_title"
                    android:textColor="#FFFFFFFF"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <androidx.appcompat.widget.SwitchCompat
                    android:id="@+id/aiDetectionSwitch"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:contentDescription="@string/ai_detection_title"
                    android:saveEnabled="false"
                    android:showText="false"
                    app:thumbTint="@color/ai_detection_switch_thumb"
                    app:trackTint="@color/ai_detection_switch_track" />
            </LinearLayout>

            <TextView
                android:id="@+id/aiDetectionStatusText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="@string/ai_detection_status_initializing"
                android:textColor="#FF72D9FF"
                android:textSize="11sp" />
        </LinearLayout>
    </FrameLayout>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/bottomActionBar"
        android:layout_width="0dp"
        android:layout_height="108dp"
        android:paddingStart="0dp"
        android:paddingEnd="0dp"
        app:layout_constraintBottom_toTopOf="@+id/footerText"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <FrameLayout
            android:id="@+id/leftRoot"
            android:layout_width="92dp"
            android:layout_height="96dp"
            android:layout_marginEnd="2dp"
            android:background="@android:color/transparent"
            android:clickable="true"
            android:focusable="true"
            android:foreground="@drawable/home_action_feedback"
            app:layout_constraintEnd_toStartOf="@+id/refreshButton"
            app:layout_constraintHorizontal_bias="0"
            app:layout_constraintHorizontal_chainStyle="packed"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <ImageView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:padding="0dp"
                android:scaleType="fitCenter"
                android:src="@drawable/home_feature_fire" />
        </FrameLayout>

        <FrameLayout
            android:id="@+id/refreshButton"
            android:layout_width="92dp"
            android:layout_height="96dp"
            android:layout_marginEnd="2dp"
            android:background="@android:color/transparent"
            android:clickable="true"
            android:focusable="true"
            android:foreground="@drawable/home_action_feedback"
            app:layout_constraintEnd_toStartOf="@+id/probeWaypointButton"
            app:layout_constraintStart_toEndOf="@+id/leftRoot"
            app:layout_constraintTop_toTopOf="parent">

            <ImageView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:padding="0dp"
                android:scaleType="fitCenter"
                android:src="@drawable/home_feature_route" />
        </FrameLayout>

        <FrameLayout
            android:id="@+id/probeWaypointButton"
            android:layout_width="92dp"
            android:layout_height="96dp"
            android:layout_marginEnd="2dp"
            android:background="@android:color/transparent"
            android:clickable="true"
            android:focusable="true"
            android:foreground="@drawable/home_action_feedback"
            app:layout_constraintEnd_toStartOf="@+id/deviceStatusButton"
            app:layout_constraintStart_toEndOf="@+id/refreshButton"
            app:layout_constraintTop_toTopOf="parent">

            <ImageView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:padding="0dp"
                android:scaleType="fitCenter"
                android:src="@drawable/home_feature_kmz" />

            <TextView
                android:layout_width="64dp"
                android:layout_height="10dp"
                android:layout_gravity="center_horizontal|bottom"
                android:layout_marginBottom="10dp"
                android:background="@drawable/home_feature_subtitle_cover"
                android:gravity="center"
                android:includeFontPadding="false"
                android:text="@string/home_feature_kmz_subtitle"
                android:textColor="#FF72D9FF"
                android:textSize="6sp" />
        </FrameLayout>

        <FrameLayout
            android:id="@+id/deviceStatusButton"
            android:layout_width="92dp"
            android:layout_height="96dp"
            android:layout_marginEnd="34dp"
            android:background="@android:color/transparent"
            android:clickable="true"
            android:focusable="true"
            android:foreground="@drawable/home_action_feedback"
            app:layout_constraintEnd_toStartOf="@+id/openSampleToolsButton"
            app:layout_constraintStart_toEndOf="@+id/probeWaypointButton"
            app:layout_constraintTop_toTopOf="parent">

            <ImageView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:padding="0dp"
                android:scaleType="fitCenter"
                android:src="@drawable/home_feature_device" />
        </FrameLayout>

        <FrameLayout
            android:id="@+id/openSampleToolsButton"
            android:layout_width="300dp"
            android:layout_height="96dp"
            android:background="@android:color/transparent"
            android:clickable="true"
            android:focusable="true"
            android:foreground="@drawable/home_action_feedback"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@+id/deviceStatusButton"
            app:layout_constraintTop_toTopOf="parent">

            <ImageView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:padding="0dp"
                android:scaleType="fitCenter"
                android:src="@drawable/home_open_flight_trimmed" />
        </FrameLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>

    <TextView
        android:id="@+id/statusText"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:text="@string/app_status_placeholder"
        android:visibility="gone"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <FrameLayout
        android:id="@+id/executeLocalKmzButton"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:clickable="true"
        android:focusable="true"
        android:visibility="gone"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/footerText"
        android:layout_width="0dp"
        android:layout_height="20dp"
        android:gravity="center_vertical"
        android:text="UAV Fire RC Plus MSDK Agent  |  Android execution shell for the dual-stream PoC."
        android:textColor="#66FFFFFF"
        android:textSize="10dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />
</androidx.constraintlayout.widget.ConstraintLayout>
