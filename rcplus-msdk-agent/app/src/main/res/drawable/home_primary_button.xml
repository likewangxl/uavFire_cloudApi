<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape>
            <gradient android:angle="0" android:startColor="#FF0F66CC" android:endColor="#FF16B7FF" />
            <stroke android:width="1dp" android:color="#FFFFFFFF" />
            <corners android:radius="4dp" />
        </shape>
    </item>
    <item>
        <shape>
            <gradient android:angle="0" android:startColor="#CC073A83" android:endColor="#CC0D7DDE" />
            <stroke android:width="1dp" android:color="#FF2AA8FF" />
            <corners android:radius="4dp" />
        </shape>
    </item>
</selector>
