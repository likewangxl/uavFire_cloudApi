page {
  min-height: 100%;
  background: #02070d;
  color: #f4f8ff;
  font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
}

button {
  border-radius: 12rpx;
}

button::after {
  border: 0;
}

.page-shell {
  min-height: 100vh;
  box-sizing: border-box;
  padding: 32rpx 28rpx calc(48rpx + env(safe-area-inset-bottom));
  background:
    linear-gradient(rgba(113, 179, 255, 0.05) 1px, transparent 1px),
    linear-gradient(90deg, rgba(113, 179, 255, 0.05) 1px, transparent 1px),
    linear-gradient(180deg, #06111f 0%, #02070d 100%);
  background-size: 44rpx 44rpx, 44rpx 44rpx, 100% 100%;
}

.panel {
  box-sizing: border-box;
  border: 1rpx solid rgba(69, 221, 255, 0.18);
  border-radius: 20rpx;
  background: rgba(7, 18, 33, 0.9);
  box-shadow: 0 18rpx 48rpx rgba(0, 0, 0, 0.24);
}

.section-title {
  margin: 34rpx 0 18rpx;
  color: #dff6ff;
  font-size: 30rpx;
  font-weight: 650;
}

.muted {
  color: #8fa6c1;
}

.status-pill {
  display: inline-flex;
  align-items: center;
  min-height: 44rpx;
  box-sizing: border-box;
  padding: 6rpx 18rpx;
  border: 1rpx solid rgba(69, 221, 255, 0.25);
  border-radius: 999rpx;
  background: rgba(69, 221, 255, 0.1);
  color: #9be7ff;
  font-size: 22rpx;
}

.status-pill.warning {
  border-color: rgba(255, 191, 77, 0.3);
  background: rgba(255, 191, 77, 0.1);
  color: #ffd38a;
}

.primary-action {
  min-height: 88rpx;
  margin-top: 28rpx;
  background: linear-gradient(90deg, #2174d9, #17b7dc);
  color: #ffffff;
  font-size: 30rpx;
  font-weight: 650;
  line-height: 88rpx;
}

.primary-action[disabled] {
  background: rgba(125, 163, 188, 0.24);
  color: #80a7c2;
}
