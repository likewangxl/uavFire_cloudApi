/* Light iOS grouped surfaces: system typography, 44pt hit areas and explicit action hierarchy. */
page { background:#f2f2f7; color:#1c1c1e; font-family:-apple-system,BlinkMacSystemFont,"Helvetica Neue",sans-serif; font-size:34rpx; line-height:1.45; }
.page-shell { background:#f2f2f7; padding:24rpx 32rpx calc(48rpx + env(safe-area-inset-bottom)); }
.panel { background:#fff; border:0; border-radius:24rpx; box-shadow:none; }
button { min-height:44px; border:0; border-radius:20rpx; font-size:34rpx; font-weight:500; color:#007aff; background:transparent; }
button[disabled] { color:#8e8e93; background:#e5e5ea; }
.primary-action { background:#007aff; color:#fff; border:0; font-weight:600; }
.secondary-action { background:#fff; color:#007aff; border:0; }
.compact-button { color:#007aff; background:#eaf3ff; font-size:30rpx; }
.text-button { color:#007aff; font-size:30rpx; font-weight:500; }
.section-title { font-size:40rpx; color:#1c1c1e; font-weight:650; letter-spacing:-.5rpx; }
.muted { color:#636366; font-size:28rpx; }
.status-pill { background:#f2f2f7; color:#636366; font-size:26rpx; border-radius:10rpx; padding:6rpx 14rpx; }
.notice { background:#e9e9ef; color:#48484a; font-size:28rpx; border:0; }
.notice-error { background:#fff0ee; color:#b42318; }
.picker-face { background:#fff; border:0; border-radius:20rpx; padding:24rpx 28rpx; }
.picker-label { font-size:28rpx; color:#636366; }
.picker-value { font-size:32rpx; }
.picker-hint { color:#007aff; font-size:28rpx; }
.search-line input { background:#e3e3e9; border:0; font-size:30rpx; border-radius:20rpx; }
.search-line button { color:#007aff; background:transparent; }
.record-card { border:0; padding:28rpx; margin:20rpx 0; border-radius:24rpx; }
.item-title { font-size:34rpx; font-weight:600; line-height:1.5; }
.record-time { font-size:26rpx; color:#636366; }
.record-link { color:#007aff; font-size:28rpx; }
.list-meta { font-size:26rpx; color:#636366; }
.segmented { background:#e5e5ea; border-radius:18rpx; padding:5rpx; }
.segmented button { font-size:28rpx; border:0; border-radius:14rpx; color:#48484a; }
.segmented button.selected { border:0; color:#1c1c1e; background:#fff; box-shadow:0 2rpx 8rpx rgba(0,0,0,.12); }
.fact { border-color:#e5e5ea; padding:24rpx 0; }
.fact-label { font-size:28rpx; color:#636366; }
.fact-value { font-size:30rpx; color:#1c1c1e; }
.form-label { font-size:30rpx; }
.form-input { font-size:34rpx; border-color:#d1d1d6; border-radius:16rpx; }
.field-error { font-size:26rpx; }
.preference-label { font-size:34rpx; }
.account-footer .secondary-action { color:#d70015; }
.auto-refresh-label { color:#636366; font-size:24rpx; line-height:1.5; }
.report-metrics { display:grid; grid-template-columns:repeat(2,minmax(0,1fr)); gap:2rpx; background:#e5e5ea; border-radius:24rpx; overflow:hidden; margin:24rpx 0; }
.report-metric { min-width:0; background:#fff; padding:26rpx; }
.report-metric-label { display:block; color:#636366; font-size:26rpx; line-height:1.5; }
.report-metric-value { display:block; color:#1c1c1e; font-size:40rpx; font-weight:600; line-height:1.4; margin-top:8rpx; word-break:break-all; }
.report-section { margin-top:28rpx; }
.report-section-title { font-size:34rpx; font-weight:600; color:#1c1c1e; margin-bottom:16rpx; }
.report-subtitle { font-size:26rpx; color:#636366; }
.record-sample { border-bottom:1rpx solid #e5e5ea; padding:24rpx 0; word-break:break-all; }
.record-sample:last-child { border-bottom:0; }
.sample-grid { display:grid; grid-template-columns:repeat(2,minmax(0,1fr)); gap:12rpx; margin-top:14rpx; font-size:27rpx; }
