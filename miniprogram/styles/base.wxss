page {
  background: #ffffff;
  color: #20242a;
  font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
  font-size: 28rpx;
  line-height: 1.6;
}
view, button, input, picker, scroll-view { box-sizing: border-box; }
button {
  display: flex;
  align-items: center;
  justify-content: center;
  width: auto;
  max-width: 100%;
  min-width: 0;
  min-height: 44px;
  margin: 0;
  padding: 18rpx 28rpx;
  border: 1rpx solid #cbd0d7;
  border-radius: 14rpx;
  background: #ffffff;
  color: #262b32;
  font-size: 28rpx;
  font-weight: 500;
  line-height: 1.4;
  white-space: normal;
  word-break: break-all;
}
button::after { border: 0; }
button[disabled] { color: #626973; background: #f0f2f4; border-color: #dde1e6; }
.button-pressed, .card-pressed { background: #edf0f3; }
.page-shell { width: 100%; min-height: 100%; padding: 24rpx 28rpx calc(48rpx + env(safe-area-inset-bottom)); background: #ffffff; }
.panel { width: 100%; min-width: 0; border: 1rpx solid #e0e4e9; border-radius: 18rpx; background: #ffffff; }
.box { padding: 28rpx; margin: 24rpx 0; }
.section-title { min-width: 0; margin: 0; font-size: 32rpx; font-weight: 650; color: #20242a; line-height: 1.5; word-break: break-all; }
.page-heading { margin: 8rpx 0 24rpx; }
.section-heading { display: flex; align-items: center; justify-content: space-between; gap: 16rpx; margin: 32rpx 0 14rpx; }
.section-heading .section-title { flex: 1; }
.muted { color: #626973; font-size: 25rpx; line-height: 1.6; word-break: break-all; }
.status-pill { display: inline-flex; max-width: 100%; flex-shrink: 0; align-items: center; padding: 5rpx 16rpx; border-radius: 10rpx; background: #f0f2f4; color: #414852; font-size: 23rpx; line-height: 1.5; word-break: break-all; }
.status-pill.warning { background: #fff5e6; color: #79501c; }
.primary-action { width: 100%; background: #edf0f3; border-color: #bdc5ce; color: #191e25; font-weight: 650; }
.secondary-action { width: 100%; }
.compact-button { flex-shrink: 0; width: auto; padding: 14rpx 22rpx; font-size: 26rpx; }
.text-button { flex-shrink: 0; width: auto; border: 0; padding: 12rpx 8rpx; background: transparent; font-size: 25rpx; color: #454d58; }
.action-stack { display: flex; flex-direction: column; gap: 20rpx; margin-top: 24rpx; }
.action-row { display: flex; flex-wrap: wrap; align-items: center; gap: 16rpx; margin-top: 20rpx; }
.notice { min-width: 0; padding: 22rpx 24rpx; margin: 20rpx 0; border-radius: 14rpx; background: #f4f5f7; color: #4b535e; font-size: 25rpx; line-height: 1.7; word-break: break-all; }
.notice-error { color: #8c2d29; background: #fff3f1; border: 1rpx solid #f0d5d1; }
.empty { padding: 44rpx 16rpx; color: #626973; font-size: 27rpx; text-align: center; word-break: break-all; }
.empty-title { color: #303741; font-weight: 600; margin-bottom: 8rpx; }
.empty .compact-button { margin: 24rpx auto 0; }
.list-meta { margin: 20rpx 0 12rpx; color: #626973; font-size: 25rpx; }
.record-card { display: block; margin: 18rpx 0; padding: 26rpx; min-width: 0; width: 100%; }
.record-top { display: flex; flex-wrap: wrap; align-items: center; gap: 12rpx; }
.record-time { color: #626973; font-size: 23rpx; min-width: 0; word-break: break-all; }
.item-title { min-width: 0; max-width: 100%; margin: 16rpx 0 12rpx; font-size: 30rpx; font-weight: 600; line-height: 1.6; white-space: normal; word-break: break-all; overflow-wrap: anywhere; }
.record-bottom { display: flex; flex-wrap: wrap; align-items: flex-start; gap: 8rpx 16rpx; }
.record-bottom .muted { flex: 1; min-width: 100rpx; }
.record-link { flex-shrink: 0; color: #414852; font-size: 24rpx; }
.list-footer { margin: 24rpx 0 0; padding: 16rpx 0 8rpx; text-align: center; }
.list-footer button { width: 100%; margin-bottom: 12rpx; }
.search-line { display: flex; align-items: stretch; gap: 14rpx; width: 100%; margin-bottom: 20rpx; }
.search-line input { flex: 1; width: 0; min-width: 0; height: 88rpx; min-height: 44px; padding: 0 20rpx; background: #f7f8fa; border: 1rpx solid #d8dde4; border-radius: 14rpx; font-size: 27rpx; color: #20242a; }
.search-line button { width: 124rpx; min-width: 60px; padding: 12rpx; flex: 0 0 auto; }
.filter-line { display: flex; align-items: center; gap: 16rpx; margin: 18rpx 0; }
.filter-picker { flex: 1; min-width: 0; }
.picker-face { display: flex; align-items: center; gap: 20rpx; width: 100%; min-height: 44px; padding: 18rpx 22rpx; border: 1rpx solid #cbd0d7; border-radius: 14rpx; background: #ffffff; }
.picker-label { flex: 0 0 auto; color: #626973; font-size: 25rpx; }
.picker-value { flex: 1; min-width: 0; color: #20242a; font-size: 28rpx; word-break: break-all; }
.picker-hint { flex-shrink: 0; color: #626973; font-size: 24rpx; }
.fact { display: flex; flex-wrap: wrap; gap: 8rpx 24rpx; padding: 22rpx 0; border-bottom: 1rpx solid #e7e9ed; }
.fact:last-child { border-bottom: 0; }
.fact-label { flex: 0 0 152rpx; color: #626973; font-size: 25rpx; }
.fact-value { flex: 1; min-width: 180rpx; color: #252b33; font-size: 27rpx; line-height: 1.7; word-break: break-all; overflow-wrap: anywhere; }
.segmented { display: flex; width: 100%; padding: 6rpx; gap: 6rpx; border-radius: 14rpx; background: #f0f2f4; margin: 24rpx 0; }
.segmented button { flex: 1; width: 0; min-width: 0; padding: 14rpx 8rpx; border: 1rpx solid transparent; border-radius: 10rpx; background: transparent; color: #626973; font-size: 27rpx; }
.segmented button.selected { background: #ffffff; border-color: #d4dae1; color: #20242a; font-weight: 650; }
.timeline-row { min-width: 0; padding: 22rpx 0; border-bottom: 1rpx solid #e7e9ed; word-break: break-all; }
.timeline-row:last-child { border-bottom: 0; }
.timeline-title { font-size: 28rpx; color: #262d35; margin: 6rpx 0; }
.form-field { margin-top: 24rpx; }
.form-label { display: block; color: #303741; font-size: 27rpx; margin-bottom: 10rpx; }
.form-input { width: 100%; height: 92rpx; min-height: 46px; padding: 0 20rpx; background: #ffffff; border: 1rpx solid #cbd0d7; border-radius: 12rpx; color: #20242a; font-size: 28rpx; }
.form-input.invalid { border-color: #b55c54; }
.field-error { display: block; margin-top: 8rpx; color: #943a31; font-size: 24rpx; }
.preference-row { display: flex; align-items: center; gap: 24rpx; min-height: 102rpx; padding: 18rpx 0; border-bottom: 1rpx solid #e7e9ed; }
.preference-row:last-child { border-bottom: 0; }
.preference-label { flex: 1; min-width: 0; color: #303741; word-break: break-all; }
.preference-row switch { flex: 0 0 auto; }
