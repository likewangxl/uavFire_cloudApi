<import src="../../templates/list.wxml" />
<view class="page-shell">
  <view class="section-title page-heading">巡检任务</view>
  <view class="search-line"><input value="{{keyword}}" bindinput="input" bindconfirm="search" confirm-type="search" maxlength="128" placeholder="任务名称、编号或机型" placeholder-style="color:#707782" aria-label="搜索巡检任务" /><button bindtap="search" disabled="{{loading}}">搜索</button></view>
  <template is="statusFilter" data="{{statusOptions, statusIndex, filterLabel, hasFilters}}" />
  <template is="recordList" data="{{items, loading, error, authenticated, total, hasMore, hasLoaded, hasFilters}}" />
</view>
