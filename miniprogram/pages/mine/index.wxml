<view class="page-shell">
  <view class="panel system-card">
    <view class="system-row">
      <text>后端 HTTPS 地址</text>
      <text class="status-pill {{apiStatus === '已配置' ? '' : 'warning'}}">{{apiStatus}}</text>
    </view>
    <view class="system-row">
      <text>微信账号</text>
      <text class="muted">{{loginStatus}}</text>
    </view>
    <view class="system-row">
      <text>客户端版本</text>
      <text class="muted">{{clientVersion}}</text>
    </view>
    <view class="system-row">
      <text>飞行控制</text>
      <text class="status-pill warning">{{flightControlStatus}}</text>
    </view>
  </view>
  <button class="secondary-action" bindtap="clearSession">清除本机登录凭证</button>
</view>
