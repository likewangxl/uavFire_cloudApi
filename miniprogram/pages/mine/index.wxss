.system-card {
  padding: 10rpx 28rpx;
}

.system-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  min-height: 106rpx;
  border-bottom: 1rpx solid rgba(103, 184, 255, 0.12);
  color: #dff6ff;
  font-size: 25rpx;
}

.system-row:last-child {
  border-bottom: 0;
}

.secondary-action {
  min-height: 84rpx;
  margin-top: 28rpx;
  border: 1rpx solid rgba(103, 184, 255, 0.24);
  background: rgba(103, 184, 255, 0.08);
  color: #9be7ff;
  font-size: 27rpx;
  line-height: 84rpx;
}
