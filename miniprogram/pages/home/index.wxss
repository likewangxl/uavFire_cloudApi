.topbar { display: flex; align-items: flex-start; gap: 20rpx; margin: 8rpx 0 22rpx; }
.topbar-main { flex: 1; min-width: 0; }
.product-title { color: #20242a; font-size: 34rpx; font-weight: 700; line-height: 1.5; word-break: break-all; }
.workspace-name { margin-top: 8rpx; color: #626973; font-size: 25rpx; word-break: break-all; }
.situation-panel { padding: 28rpx; background: #fafbfc; }
.panel-kicker { color: #626973; font-size: 25rpx; }
.headline { margin-top: 10rpx; color: #20242a; font-size: 36rpx; font-weight: 650; line-height: 1.5; word-break: break-all; }
.metric-grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 14rpx; margin-top: 24rpx; }
.metric-item { min-width: 0; padding: 18rpx 14rpx; border: 1rpx solid #e0e4e9; border-radius: 12rpx; background: #ffffff; }
.metric-label { display: block; min-height: 68rpx; color: #626973; font-size: 24rpx; line-height: 1.5; white-space: normal; word-break: break-all; }
.metric-value { display: block; margin-top: 8rpx; color: #20242a; font-size: 38rpx; font-weight: 650; line-height: 1.3; word-break: break-all; }
.summary-footer { display: flex; align-items: center; justify-content: space-between; gap: 16rpx; margin-top: 20rpx; }
.summary-footer .muted { flex: 1; min-width: 0; font-size: 24rpx; }
.summary-footer { flex-wrap: wrap; }
.situation-panel { background:#fff; }
.product-title { font-size:40rpx; letter-spacing:-.5rpx; }
.workspace-name { font-size:28rpx; color:#636366; }
.headline { font-size:56rpx; font-weight:650; letter-spacing:-.7rpx; }
.metric-grid { gap:0; background:#f2f2f7; border-radius:18rpx; padding:6rpx; }
.metric-item { border:0; border-radius:0; background:transparent; padding:18rpx 14rpx; }
.metric-item + .metric-item { border-left:1rpx solid #d9d9df; }
.metric-label { font-size:24rpx; color:#636366; min-height:70rpx; }
.metric-value { font-size:44rpx; font-weight:600; }
.data-warning { margin: 12rpx 0 0; color: #565e69; font-size: 25rpx; line-height: 1.7; word-break: break-all; }
