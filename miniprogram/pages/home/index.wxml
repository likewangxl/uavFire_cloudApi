<import src="../../templates/list.wxml" />
<view class="page-shell home-page">
  <view class="topbar"><view class="topbar-main"><view class="product-title">无人机火情智巡</view><view class="workspace-name">{{workspaceName || '巡护工作台'}}</view></view><text class="status-pill">{{authenticated ? '已登录' : '未登录'}}</text></view>
  <view class="panel situation-panel">
    <text class="panel-kicker">今日巡护</text><view class="headline">{{headline}}</view>
    <view class="metric-grid">
      <view class="metric-item" aria-role="button" aria-label="查看巡检任务" bindtap="openTasks"><text class="metric-label">今日执行任务</text><text class="metric-value">{{todayTasks}}</text></view>
      <view class="metric-item" aria-role="button" aria-label="查看火情事件" bindtap="openEvents"><text class="metric-label">待复核事件</text><text class="metric-value">{{urgentEvents}}</text></view>
      <view class="metric-item"><text class="metric-label">在线航空器</text><text class="metric-value">{{onlineAircraft}}</text></view>
    </view>
    <view wx:if="{{authenticated}}" class="summary-footer"><text class="muted">{{generatedAt ? '最后更新 ' + generatedAt : '正在读取数据'}}</text><text class="auto-refresh-label">每 5 秒自动更新</text></view>
    <block wx:if="{{warning}}"><button class="text-button" bindtap="toggleWarnings">{{showWarnings ? '收起数据说明' : '查看数据说明'}}</button><view wx:if="{{showWarnings}}" class="data-warning">{{warning}}</view></block>
  </view>
  <view wx:if="{{error}}" class="notice notice-error">{{error}}</view>
  <view wx:if="{{!authenticated}}" class="action-stack"><button class="primary-action" bindtap="handleLogin">微信登录并进入</button></view>
  <block wx:if="{{authenticated && hasLoaded}}">
    <view class="section-heading"><view class="section-title">待复核动态</view><button class="text-button" bindtap="openEvents">查看全部</button></view>
    <block wx:for="{{urgentItems}}" wx:key="id"><template is="recordCard" data="{{item}}" /></block>
    <view wx:if="{{!urgentItems.length}}" class="panel empty">暂无待复核事件</view>
    <view class="section-heading"><view class="section-title">巡护进行时</view><button class="text-button" bindtap="openTasks">查看全部</button></view>
    <block wx:for="{{activeTasks}}" wx:key="id"><template is="recordCard" data="{{item}}" /></block>
    <view wx:if="{{!activeTasks.length}}" class="panel empty">暂无执行中的任务</view>
    <view class="section-heading"><view class="section-title">最新执行报告</view><button class="text-button" bindtap="openReports">查看全部</button></view>
    <block wx:for="{{reports}}" wx:key="id"><template is="recordCard" data="{{item}}" /></block>
    <view wx:if="{{!reports.length}}" class="panel empty">暂无任务执行报告</view>
  </block>
</view>
