<view class="page-shell">
  <view wx:if="{{loading}}" class="empty">正在读取记录…</view>
  <view wx:if="{{error}}" class="notice notice-error"><view>{{error}}</view><view class="action-row"><button class="compact-button" bindtap="retry">{{authenticated ? '重新加载' : '前往登录'}}</button></view></view>
  <block wx:if="{{record}}">
    <view class="detail-heading"><text class="status-pill">{{record.statusLabel}}</text><view class="detail-title">{{displayName}}</view><view class="muted">{{updatedAt}}</view><button class="text-button" bindtap="copyId">复制{{kind === 'events' ? '事件' : '任务'}}编号</button></view>
    <view wx:if="{{record.dataStatus === 'STALE'}}" class="notice">当前执行状态待更新，以下为最近一次记录。</view>
    <view class="segmented"><button class="{{section === 'overview' ? 'selected' : ''}}" data-value="overview" bindtap="switchSection">概览</button><button wx:if="{{kind !== 'events'}}" class="{{section === 'route' ? 'selected' : ''}}" data-value="route" bindtap="switchSection">航线</button><button class="{{section === 'timeline' ? 'selected' : ''}}" data-value="timeline" bindtap="switchSection">{{kind === 'events' ? '处置记录' : '执行记录'}}</button></view>
    <block wx:if="{{flightReport && section === 'overview'}}">
      <view class="section-heading"><view class="section-title">飞行报告</view></view>
      <picker wx:if="{{reportRuns.length > 1}}" mode="selector" range="{{reportRuns}}" range-key="label" value="{{reportRunIndex}}" bindchange="selectRun" disabled="{{reportLoading}}"><view class="picker-face"><text class="picker-label">执行记录</text><text class="picker-value">{{reportRuns[reportRunIndex].label}}</text><text class="picker-hint">选择</text></view></picker>
      <view wx:if="{{reportError}}" class="notice notice-error">{{reportError}}</view><view wx:if="{{reportMissingText}}" class="notice">尚未记录：{{reportMissingText}}</view>
      <view class="report-metrics"><view wx:for="{{reportMetrics}}" wx:key="label" class="report-metric"><text class="report-metric-label">{{item.label}}</text><text class="report-metric-value">{{item.value}}</text></view></view>
      <view class="panel box"><view class="report-section-title">起降、电量与记录</view><view wx:for="{{reportFacts}}" wx:key="label" class="fact"><text class="fact-label">{{item.label}}</text><text class="fact-value" selectable>{{item.value}}</text></view></view>
      <view class="panel box"><view class="report-section-title">计划参数</view><view class="report-subtitle">以下为计划设置，不代表实际飞行数据。</view><view wx:for="{{planFacts}}" wx:key="label" class="fact"><text class="fact-label">{{item.label}}</text><text class="fact-value">{{item.value}}</text></view></view>
      <view class="panel box"><view class="report-section-title">数据完整性</view><view wx:for="{{flightReport.quality.warnings}}" wx:key="*this" class="muted">{{item}}</view></view>
      <view class="panel box"><view class="report-section-title">关联火情</view><view class="report-subtitle">{{flightReport.relatedEvents.association}}</view><view wx:for="{{reportEvents}}" wx:key="eventId" class="record-sample"><view>{{item.timeLabel}} · {{item.statusLabel}}</view><text class="muted" selectable>{{item.eventId}}</text><view class="muted">等级：{{item.fireLevel || '未记录'}} · 置信度：{{item.confidence == null ? '未记录' : item.confidence}}</view></view><view wx:if="{{flightReport.relatedEvents.available && !reportEvents.length}}" class="muted">该记录时段未匹配到同设备火情记录。</view><view class="report-subtitle">已显示 {{reportEvents.length}} / {{flightReport.relatedEvents.total || 0}} 项</view><button wx:if="{{flightReport.relatedEvents.hasMore}}" class="text-button" data-kind="events" bindtap="loadMoreRelated" loading="{{reportLoading}}" disabled="{{reportLoading}}">加载更多火情</button></view>
      <view class="panel box"><view class="report-section-title">媒体与成果</view><view class="report-subtitle">{{flightReport.media.note || '没有可验证的媒体元数据'}}</view><view wx:for="{{flightReport.media.items}}" wx:key="fileId" class="record-sample">{{item.fileName}}</view><view class="report-subtitle">已显示 {{flightReport.media.items.length || 0}} / {{flightReport.media.total || 0}} 项</view><button wx:if="{{flightReport.media.hasMore}}" class="text-button" data-kind="media" bindtap="loadMoreRelated" loading="{{reportLoading}}" disabled="{{reportLoading}}">加载更多媒体</button></view>
    </block>
    <view wx:if="{{section === 'overview'}}" class="panel box">
      <view wx:for="{{facts}}" wx:key="label" class="fact"><text class="fact-label">{{item.label}}</text><text class="fact-value" selectable>{{item.value}}</text></view>
      <view wx:if="{{record.taskStatusReason}}" class="notice">{{record.taskStatusReason}}</view><view wx:if="{{kind === 'events'}}" class="notice">{{record.positionNote}}。现场影像尚未接入。</view>
    </view>
    <view wx:if="{{section === 'route'}}" class="panel box">
      <view class="route-head"><text>航点列表（WGS84）</text><text class="muted">已显示 {{waypoints.length}} / {{waypointTotal}} 个</text></view><view wx:if="{{record.routeWarning}}" class="notice">{{record.routeWarning}}</view>
      <view wx:for="{{waypoints}}" wx:key="index" class="fact"><text class="fact-label">航点 {{item.index}}</text><text class="fact-value" selectable>纬度：{{item.lat}}
经度：{{item.lng}}</text></view>
      <view wx:if="{{!waypointTotal}}" class="empty">暂无可用航点记录</view><button wx:if="{{waypointHasMore}}" class="secondary-action" bindtap="loadMoreWaypoints">加载更多航点</button>
    </view>
    <view wx:if="{{section === 'timeline'}}" class="panel box"><view wx:for="{{timeline}}" wx:key="key" class="timeline-row"><text class="muted">{{item.time}}</text><view class="timeline-title">{{item.title}}</view><text wx:if="{{item.note}}" class="muted">{{item.note}}</text></view><view wx:for="{{reportTimeline}}" wx:key="key" class="timeline-row"><text class="muted">{{item.timeLabel}}</text><view class="timeline-title">{{item.title}}</view><text class="muted">{{item.message || ''}}</text></view><view wx:if="{{!timeline.length && !reportTimeline.length}}" class="empty">暂无已记录的时间线</view></view>
    <view wx:if="{{section === 'timeline' && flightReport}}" class="panel box"><view class="report-section-title">完整执行与遥测记录</view><view class="report-subtitle">共 {{reportRecordTotal}} 条，已显示 {{reportRecords.length}} 条。</view><view wx:if="{{reportError}}" class="notice notice-error">{{reportError}}</view><view wx:for="{{reportRecords}}" wx:key="recordId" class="record-sample"><view>{{item.timeLabel}}</view><view class="muted">{{item.sourceLabel}} · {{item.kindLabel}} · {{item.flyingLabel}}</view><view class="sample-grid"><text>速度 {{item.speedLabel}}</text><text>相对高度 {{item.heightLabel}}</text><text>电量 {{item.batteryLabel}}</text><text>垂直速度 {{item.verticalSpeedLabel}}</text><text>风速 {{item.windLabel}}</text><text>飞行模式 {{item.modeLabel}}</text></view><view class="muted" selectable>坐标（WGS84） {{item.locationLabel}}</view><view class="muted">绝对高度 {{item.altitudeLabel}} · 定位 {{item.fixedLabel}}</view><view class="muted">服务端接收 {{item.receivedLabel}}</view><view class="muted">卫星 {{item.gpsLabel}} · 进度 {{item.progressLabel}} · 航点索引 {{item.waypointLabel}}</view><view wx:if="{{item.eventState || item.eventMessage}}" class="muted">{{item.eventState}} {{item.eventMessage}}</view></view><button wx:if="{{reportHasMore}}" class="secondary-action" loading="{{reportLoading}}" disabled="{{reportLoading}}" bindtap="loadMoreRecords">加载更多记录</button></view>
    <block wx:if="{{kind === 'reports'}}"><view class="notice">{{record.reportNote}}</view><view class="action-stack detail-actions"><button class="primary-action" bindtap="bookmark" loading="{{saving}}" disabled="{{saving || loading}}">{{record.saved ? '取消收藏' : '收藏报告'}}</button><button class="secondary-action" bindtap="relatedTask">查看关联任务</button></view></block>
  </block>
</view>
